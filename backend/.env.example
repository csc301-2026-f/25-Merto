# Server-side PostgreSQL connection to the team's Supabase project
# (Project Settings > Database > Connection string). Never commit the real value.
# Leave unset to run against the in-memory sandbox built from supabase/.
DATABASE_URL=
# For hosted Supabase, verify TLS using its public CA certificate:
# Append ?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt to the URL.
PORT=3001
# Shared password for the frontend's development sign-in (POST /auth/login).
# The sandbox uses "test" when this is empty; a real database has sign-in off
# unless this is set. Not real authentication: staff are named by email only.
DEV_LOGIN_PASSWORD=
