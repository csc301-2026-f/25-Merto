# Server-side PostgreSQL connection to the team's Supabase project
# (Project Settings > Database > Connection string). Never commit the real value.
# Leave unset to run against the in-memory sandbox built from supabase/.
DATABASE_URL=
# For hosted Supabase, verify TLS using its public CA certificate:
# Append ?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt to the URL.
PORT=3001
# Shared password for the frontend's development sign-in (POST /auth/login).
# The sandbox uses "test" when this is empty; a real database has sign-in off
# unless this is set. Not real authentication: staff are named by email only.
DEV_LOGIN_PASSWORD=

# US14: server-only Groq API key. Never use a NEXT_PUBLIC_ variable for this.
# Create a key at https://console.groq.com/keys. No template fallback is used.
GROQ_API_KEY=
# Optional model override; choose a Groq chat model supporting reasoning_effort.
GROQ_MODEL=openai/gpt-oss-20b

# Optional hosted evaluation: Python MPNet service origin, separate from this API.
# With both set, AI Review offers Deterministic and MPNet. No weights run in Node.
MERTO_MODEL_URL=
# Same server-only secret as the model service. Never expose it with NEXT_PUBLIC_.
MERTO_MODEL_TOKEN=

# US13 live model agent for the scenario checks. Off unless SCENARIO_AI_LIVE=true and a key and a
# model are set. It works with any OpenAI-compatible server (OpenAI, Groq, or a local one such as
# Ollama); the provider bills each live run, a local server is free. Server-only: never use a
# NEXT_PUBLIC_ variable for these.
SCENARIO_AI_LIVE=false
# Falls back to OPENAI_API_KEY when empty.
MODEL_AGENT_API_KEY=
MODEL_AGENT_MODEL=
# Optional. Default https://api.openai.com/v1. Examples:
#   Groq (cloud, needs a key):   https://api.groq.com/openai/v1
#   Ollama (this machine):       http://localhost:11434/v1   (no key needed for localhost)
#   LM Studio (this machine):    http://localhost:1234/v1
MODEL_AGENT_BASE_URL=
# Optional. true or false forces reasoning-model settings (low effort, larger output budget);
# left empty it is guessed from the model name (o*, gpt-5*, gpt-oss).
MODEL_AGENT_REASONING=
# Optional. Milliseconds to wait for one answer (default 30000); a slow local model may need more.
MODEL_AGENT_TIMEOUT_MS=
# Optional. Live runs allowed in any rolling hour (default 30).
MODEL_AGENT_MAX_PER_HOUR=
# Optional. A fixed seed asks the provider for repeatable answers (best effort, default 42).
MODEL_AGENT_SEED=
