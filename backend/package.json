{
  "name": "merto-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "check:hosted": "tsx scripts/check-hosted.ts",
    "test": "tsx --test test/*.test.ts",
